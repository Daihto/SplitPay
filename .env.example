# Environment variables for SplitPay
# In production, set VITE_API_URL to your backend service URL
VITE_API_URL=https://splitpaybackend.onrender.com

# Optional Android emulator backend URL
# Use this when running the mobile app in Android Studio emulator
VITE_ANDROID_EMULATOR_URL=http://10.0.2.2:8080

# Optional device/backend URL for a real Android device
# Replace with your computer's LAN IP and backend port
# Example: VITE_API_URL=http://192.168.1.100:8080